# Model string follows litellm's "<provider>/<model>" convention.
AI_MODEL=anthropic/claude-sonnet-5

# Only the key matching your chosen provider is required. All of the AI
# settings below can also be set (or changed) at runtime from the
# dashboard's Settings page — these are just the initial defaults.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# IANA timezone (e.g. America/Chicago), used by the clock/date widgets.
TIMEZONE=UTC

# Root logger level: DEBUG, INFO, WARNING, or ERROR (see
# app/logging_config.py). Applies the same way on a native (systemd)
# install or Docker — both read this file — just restart the backend
# service (`tilora restart` / `systemctl restart tilora-backend`, or
# `docker compose restart backend`) after changing it. DEBUG also unlocks
# verbose third-party logging (httpx, asyncssh, icloudpy).
LOG_LEVEL=INFO

# Required only if the movies widget is enabled (themoviedb.org/settings/api).
TMDB_API_KEY=

# Required only if the Artificial Analysis widget is enabled
# (artificialanalysis.ai/data-api) — free tier, no shared/demo key exists.
ARTIFICIAL_ANALYSIS_API_KEY=

# Required only if the discord widget is enabled
# (discord.com/developers/applications). The bot must be invited to the
# server with "View Channel" + "Read Message History" permissions on the
# target channel (or thread). If it needs to read other users' message
# content, enable the "Message Content Intent" for the application in the
# developer portal.
DISCORD_BOT_TOKEN=

# Required only if the packages widget is enabled (17track.net/en/api).
TRACK17_API_KEY=

# Optional for the nasa_apod widget — it works without a key via NASA's
# shared "DEMO_KEY" (low rate limit). Set this for a personal, higher-limit
# key (api.nasa.gov).
NASA_API_KEY=

# Origin(s) the frontend dev/prod server runs on, for CORS. Comma-separated
# if you need more than one (e.g. a kiosk on localhost plus a phone/desktop
# browser on the LAN): CORS_ORIGIN=http://localhost:5173,http://192.168.1.50:3000
#
# By default, private RFC 1918 LAN subnets (10.x, 192.168.x, 172.16-31.x) and
# *.local mDNS hostnames are also allowed via CORS_ORIGIN_REGEX.
#
# This default (5173) is the local `npm run dev` / Vite port — it's NOT used
# by docker-compose, which sets CORS_ORIGIN itself (port 3000, matching its
# frontend service) directly in docker-compose.yml/.prod.yml, overriding
# whatever's in this file. Only edit this value for local (non-Docker) dev.
CORS_ORIGIN=http://localhost:5173

# "owner/repo" the update checker polls GitHub releases for. Defaults to
# upstream — if you're running a fork, set this to your own repo so the
# "update available" notice checks your releases instead of upstream's.
GITHUB_REPO=AndyG-0/tilora

# Required only if the calendar widget is enabled. Create an OAuth 2.0
# Client ID (Web application) at console.cloud.google.com, enable the Google
# Calendar API, and add {BACKEND_PUBLIC_URL}/api/calendar/auth/callback as an
# authorized redirect URI. Can also be set at runtime from the Settings page.
# Google will also block the connection ("Access blocked: app has not
# completed Google's verification process") unless you add each Google
# account you'll connect as a test user: APIs & Services -> OAuth consent
# screen -> Audience -> Test users, leaving Publishing status as "Testing" —
# full verification is only needed to move the app to "In production" for
# outside users, which a personal/home dashboard doesn't need.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Required only if a calendar widget's `provider` setting is "microsoft"
# instead of the default "google". Create an app registration at
# portal.azure.com -> Microsoft Entra ID -> App registrations -> New
# registration (platform type "Web"), then under API permissions add
# Microsoft Graph -> Delegated -> Calendars.Read and offline_access, and add
# {BACKEND_PUBLIC_URL}/api/calendar/auth/microsoft/callback as a redirect
# URI. Can also be set at runtime from the Settings page.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# The backend's own publicly reachable base URL, used to build the Google
# and Microsoft OAuth redirect URIs above (must exactly match what's
# registered with each provider). Defaults to localhost for local dev.
BACKEND_PUBLIC_URL=http://localhost:8000

# Required only if a calendar widget's `provider` setting is "caldav"
# instead of the default "google". Works with iCloud, Fastmail, Nextcloud,
# and most self-hosted calendars — usually an app-specific password rather
# than your account password. Can also be set at runtime from the Settings
# page.
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# Required only if a photos widget's `provider` setting is "icloud_private"
# instead of "local"/"icloud_shared". This is your real Apple ID and account
# password (Apple doesn't support app-specific passwords for this API), so
# it grants full access to your iCloud account, not just Photos — only use
# it if you're comfortable with that. Connecting (including any 2FA prompt)
# happens from the widget's detail view or the Settings page; this variable
# just seeds the initial value, same as the CalDAV settings above.
ICLOUD_USERNAME=
ICLOUD_PASSWORD=
