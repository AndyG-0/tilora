[Unit]
Description=Tilora - backend API
After=network.target

[Service]
Type=simple
User=__TILORA_USER__
WorkingDirectory=__TILORA_BACKEND_DIR__
# Runs the synced venv's uvicorn directly rather than `uv run uvicorn`, so
# start-up doesn't depend on `uv` being able to write to its own cache dir
# under the read-only sandbox below — `uv sync` (build step) already
# produced everything this needs.
ExecStart=__TILORA_BACKEND_DIR__/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
EnvironmentFile=__TILORA_BACKEND_DIR__/.env

# A hung AI provider call or a stuck ffmpeg transcode (spawned for the
# HDHomeRun widget's server_transcode playback mode) shouldn't be able to
# starve the Pi of memory/CPU that the frontend and kiosk Chromium also
# need. Raise these if a real workload needs more headroom.
MemoryMax=1G
CPUQuota=200%
TasksMax=256

# Sandboxing. ProtectSystem=strict makes the whole filesystem read-only
# except ReadWritePaths below — which covers storage.db, dashboard.yaml,
# and .env under the backend's own directory. If DB_PATH is overridden to
# somewhere outside this tree, add that path here too.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=__TILORA_BACKEND_DIR__
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=

# The sandbox above also blocks GPU access, so the HDHomeRun widget's
# qsv/vaapi hwaccel presets need both of these — not shipped enabled because
# SupplementaryGroups= fails the unit outright on a host with no "render"
# group. Add them with `systemctl edit tilora-backend` if you want hardware
# transcoding; see deploy/README.md.
# DeviceAllow=/dev/dri/renderD128 rw
# SupplementaryGroups=render

[Install]
WantedBy=multi-user.target
