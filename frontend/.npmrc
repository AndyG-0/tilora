engine-strict=true
# mpegts.js (HDHomeRun widget video playback) depends on webworkify-webpack,
# which is published only as a GitHub git reference, not to the npm
# registry. npm 12+ defaults allow-git to "none" as a supply-chain-security
# measure, which blocks that install; re-allow it here, scoped to this
# project only.
allow-git=all
